# Chaves de Configuração do Supabase, Mercado Pago e APIs do Sistema
SUPABASE_URL="https://xjwfzdyqjionolxsrevh.supabase.co/rest/v1/"
SUPABASE_ANON_KEY="your_supabase_anon_key_here"
# Chave de serviço (uso exclusivo no backend/server.ts - nunca prefixar com VITE_)
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key_here"
GEMINI_API_KEY="your_gemini_api_key_here"
APP_URL="https://ais-dev-bdq3svx3dm33qtw54btpck-187438088710.us-west2.run.app"
MERCADO_PAGO_ACCESS_TOKEN="your_mercado_pago_access_token_here"
MERCADO_PAGO_PUBLIC_KEY="your_mercado_pago_public_key_here"
# Segredo HMAC do webhook do Mercado Pago (painel Suas integrações -> Webhooks)
MERCADO_PAGO_WEBHOOK_SECRET="your_mercado_pago_webhook_secret_here"
# Bloqueie simulação de pagamento em produção ("false") quando operar com clientes reais
ALLOW_PAYMENT_SIMULATION="false"
JWT_SECRET="your_jwt_secret_key_here"
# Envio transacional de e-mails para redefinição de senha autônoma (Resend)
RESEND_API_KEY="your_resend_api_key_here"
EMAIL_FROM="FinanFly <onboarding@resend.dev>"
# Webhook HTTPS opcional (Discord/Slack) para receber alertas automáticos de erros 5xx ou queda do banco
MONITORING_ALERT_WEBHOOK_URL="https://discord.com/api/webhooks/your_webhook_here"
# Lista de origens CORS extras separadas por vírgula em produção (opcional)
CORS_ALLOWED_ORIGINS="https://ais-dev-bdq3svx3dm33qtw54btpck-187438088710.us-west2.run.app,https://ais-pre-bdq3svx3dm33qtw54btpck-187438088710.us-west2.run.app"
